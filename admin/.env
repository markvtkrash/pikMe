# Where the tunable above is read from: this app's own .env value (default)
# or the shared app_config DB table, managed from this app's own Config
# Management page. A DB row missing for a given key falls back to the .env
# value above automatically.
#EXPO_PUBLIC_CONFIG_SOURCE=env


