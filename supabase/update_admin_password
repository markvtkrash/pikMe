SELECT
  ur.user_id,
  u.email,
  u.created_at AS user_created_at,
  ur.created_at AS granted_admin_at
FROM public.user_roles ur
JOIN auth.users u ON u.id = ur.user_id
WHERE ur.role = 'admin'
ORDER BY ur.created_at ASC;

